# Local Docker Compose configuration. Keep real credentials in the gitignored .env file.
SPRING_PROFILES_ACTIVE=dev
MYSQL_HOST_PORT=13306
MYSQL_ROOT_PASSWORD=root_password
REDIS_HOST_PORT=16379
RABBITMQ_HOST_PORT=5672
# The compose stack boots on the `dev` profile above, so this ships the same local-only key
# `application-dev.yml` falls back to — that is what lets `start-docker.bat` work on a fresh
# clone. Compose refuses an empty value on purpose: replace this before any real deployment,
# where a non-dev profile has no fallback and would encrypt credentials with a public key.
APP_CRYPTO_AES_SECRET=prelude-dev-only-credential-key-not-for-deploy
# S3-compatible object storage (VersityGW local/CI endpoint)
S3_HOST_PORT=19000
S3_BUCKET=prelude-assets
S3_ACCESS_KEY=prelude-local-key
S3_SECRET_KEY=prelude-local-secret
S3_PUBLIC_ENDPOINT=http://127.0.0.1:19000
# Set to true in any deployment served over HTTPS so the session cookie is Secure.
SESSION_COOKIE_SECURE=false
# OAuth providers are optional; leave empty to run with password login only.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
