{
  "$schema": "ui-tokens",
  "description": "Prelude UI token schema. Source of truth for token naming and classification. Values live in frontend/src/shared/styles/index.css; this file indexes them so the verify-ui-tokens script can detect drift, missing declarations, or category reclassification without diffing the CSS by hand.",
  "categories": {
    "color": {
      "prefix": "color",
      "description": "品牌与语义颜色（含暗色模式映射）。",
      "tokens": [
        "color-bg",
        "color-surface",
        "color-surface-hover",
        "color-surface-muted",
        "color-sand",
        "color-text-primary",
        "color-text-secondary",
        "color-text-tertiary",
        "color-text-button",
        "color-border",
        "color-border-warm",
        "color-ring",
        "color-ring-deep",
        "color-line-decor",
        "color-line-decor-light",
        "color-brand",
        "color-brand-light",
        "color-accent-solid",
        "color-accent-solid-hover",
        "color-accent-text",
        "color-text-on-accent",
        "color-coral",
        "color-error",
        "color-error-soft",
        "color-focus-field",
        "color-focus-action"
      ]
    },
    "spacing": {
      "prefix": "spacing",
      "description": "间距阶梯（基于 4 / 8 / 16 / 24 / 32 / 40 + 异常值）。",
      "tokens": [
        "spacing-xs",
        "spacing-sm",
        "spacing-md",
        "spacing-lg",
        "spacing-xl",
        "spacing-2xl",
        "spacing-0"
      ]
    },
    "radius": {
      "prefix": "radius",
      "description": "圆角阶梯。",
      "tokens": [
        "radius-xs",
        "radius-sm",
        "radius-md",
        "radius-lg",
        "radius-xl",
        "radius-2xl",
        "radius-3xl",
        "radius-full"
      ]
    },
    "shadow": {
      "prefix": "shadow",
      "description": "阴影 token。原始阴影值只允许出现在 token 定义行，selector 中的 box-shadow 必须使用 var(--shadow-*) 引用。",
      "tokens": [
        "shadow-ring",
        "shadow-ring-deep",
        "shadow-whisper",
        "shadow-modal",
        "shadow-brand-metaballs",
        "shadow-login-card",
        "shadow-login-logo",
        "shadow-autofill-surface"
      ],
      "rules": {
        "raw-only-in-token-definitions": true
      }
    },
    "motion": {
      "prefix": "motion",
      "description": "动效 token（时长、缓动、过渡组合）。",
      "tokens": [
        "motion-duration-base",
        "motion-duration-fast",
        "motion-duration-slow",
        "motion-duration-thinking",
        "motion-ease-standard",
        "tracking-label",
        "motion-transition-surface"
      ]
    },
    "font": {
      "prefix": "font",
      "description": "字体族、字号、字重、行高与字距阶梯。",
      "tokens": [
        "font-serif",
        "font-sans",
        "font-mono",
        "font-size-xs",
        "font-size-sm",
        "font-size-md",
        "font-size-lg",
        "font-size-xl",
        "font-size-2xl",
        "font-weight-regular",
        "font-weight-medium",
        "font-weight-semibold",
        "line-height-solid",
        "line-height-display",
        "line-height-tight",
        "line-height-heading",
        "line-height-compact",
        "line-height-base",
        "line-height-relaxed",
        "line-height-copy",
        "tracking-eyebrow",
        "tracking-caps"
      ]
    },
    "border": {
      "prefix": "border",
      "description": "标准边界宽度。",
      "tokens": ["border-width-default"]
    },
    "ui-height": {
      "prefix": "ui-height",
      "description": "唯一的控件高度。base/compact 两档已合并为 36px 一档，密集行与滑块轨道不再自带第二档高度。",
      "tokens": ["ui-height-control"],
      "rules": {
        "design-locked": ["ui-height-control"]
      }
    },
    "ui-glyph": {
      "prefix": "ui-glyph",
      "description": "图标与图标按钮的盒尺寸；尺寸不从 spacing 阶梯借用。",
      "tokens": ["ui-glyph-sm", "ui-glyph-md", "ui-glyph-lg"]
    },
    "layout": {
      "prefix": "layout",
      "description": "跨页面布局语义尺寸（Sidebar / Settings dialog / Workspace content）。",
      "tokens": [
        "layout-sidebar-inline-size",
        "layout-sidebar-collapsed-inline-size",
        "layout-sidebar-brand-inline-size",
        "layout-sidebar-header-block-size",
        "layout-settings-sidebar-inline-size",
        "layout-dialog-workspace-min-block-size",
        "layout-workspace-content-max-inline-size",
        "layout-form-field-min-inline-size",
        "layout-list-title-min-inline-size",
        "layout-position-catalog-min-inline-size",
        "layout-position-form-min-inline-size",
        "layout-position-item-min-inline-size",
        "layout-chart-block-size",
        "layout-demo-frame-block-size",
        "layout-empty-state-min-block-size",
        "layout-lead-max-inline-size",
        "layout-prompt-input-min-block-size",
        "layout-prompt-input-max-block-size",
        "layout-prompt-truncate-max-inline-size",
        "layout-generating-card-max-inline-size",
        "layout-generating-rose-inline-size",
        "layout-workspace-report-block-padding",
        "layout-report-column-min-inline-size",
        "layout-report-label-inline-size",
        "layout-report-counter-min-inline-size",
        "layout-profile-avatar-inline-size",
        "layout-brand-mark-inline-size",
        "layout-viewport-min-inline-size",
        "layout-page-center-block-offset",
        "layout-login-card-max-inline-size",
        "layout-login-card-min-block-size",
        "layout-login-column-min-inline-size",
        "layout-login-logo-max-inline-size",
        "layout-textarea-min-block-size",
        "layout-select-list-max-block-size",
        "layout-dialog-max-inline-size",
        "layout-confirm-max-inline-size"
      ]
    },
    "content": {
      "prefix": "content",
      "description": "消息与浮层的可读内容宽度。",
      "tokens": [
        "content-message-max-inline-size",
        "content-message-bubble-max-inline-size",
        "content-report-reading-max-inline-size",
        "content-tooltip-max-inline-size"
      ]
    },
    "z-index": {
      "prefix": "z-index",
      "description": "层级 token。值必须唯一（layer 语义不重叠）。",
      "tokens": [
        "z-index-local-raised",
        "z-index-workspace-composer",
        "z-index-sidebar",
        "z-index-dialog-backdrop",
        "z-index-dialog",
        "z-index-menu",
        "z-index-tooltip"
      ],
      "rules": {
        "values-must-be-unique": true
      }
    },
    "header-composer": {
      "prefix": "header|composer",
      "description": "布局相关辅助 token（顶部高度、composer 总高），非通用尺寸。",
      "tokens": ["header-height", "composer-height"]
    },
    "chart-brand": {
      "prefix": "chart|brand|rose",
      "description": "图表与品牌图案使用的语义色（与 color-* 解耦，便于图表与背景独立调色）。",
      "tokens": [
        "chart-technical",
        "chart-expression",
        "chart-logic",
        "brand-metaballs-1",
        "brand-metaballs-2",
        "brand-metaballs-3",
        "brand-metaballs-4",
        "brand-metaballs-5",
        "brand-metaballs-bg"
      ]
    },
    "component-tailwind-theme": {
      "prefix": null,
      "description": "Tailwind @theme block 的组件语义 token，与 index.css 中的声明保持一致。",
      "tokens": [
        "background",
        "foreground",
        "card",
        "card-foreground",
        "popover",
        "popover-foreground",
        "primary",
        "primary-foreground",
        "secondary",
        "secondary-foreground",
        "muted",
        "muted-foreground",
        "accent",
        "accent-foreground",
        "destructive",
        "destructive-foreground",
        "border",
        "input",
        "ring",
        "ease-standard",
        "tracking-label",
        "color-background",
        "color-foreground",
        "color-card",
        "color-card-foreground",
        "color-popover",
        "color-popover-foreground",
        "color-primary",
        "color-primary-foreground",
        "color-secondary",
        "color-secondary-foreground",
        "color-muted",
        "color-muted-foreground",
        "color-accent",
        "color-accent-foreground",
        "color-destructive",
        "color-destructive-foreground",
        "color-border",
        "color-input",
        "color-ring"
      ]
    },
    "supporting": {
      "prefix": null,
      "description": "登录背景、弹层遮罩与模糊、基础圆角、分段控件和登录内容层使用的辅助 token。",
      "tokens": [
        "radius",
        "bg-paper-filter",
        "mask-overlay",
        "ui-segmented-item-min-inline-size",
        "ui-control-inset",
        "login-card-content-layer",
        "overlay-blur-radius"
      ]
    },
    "scoped-component-private": {
      "prefix": null,
      "description": "组件私有变量不在本索引集中管理；脚本跳过其全局校验，但组件属性只引用命名语义变量。",
      "tokens": []
    }
  },
  "rules": {
    "shadow-raw-only-in-definitions": "selector 中的 box-shadow 必须使用 var(--shadow-*)，不允许裸阴影值。",
    "z-index-values-unique": "任意 --z-index-* token 的值互不相等；如果发现重复说明层级冲突。",
    "design-locked-values": "design-locked 列表中的 token 值不得随意变更（受 DESIGN.md 约束）；脚本会断言当前值与 DESIGN.md 描述一致。",
    "no-shadow-raw-in-selector": "selector 中的 box-shadow 值若不是 var(--shadow-*)，则视为 raw shadow violation。"
  },
  "design_lock_values": {
    "ui-height-control": "36px"
  }
}
