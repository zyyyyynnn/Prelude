{
  "name": "prelude-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "check": "vp check",
    "build": "vp build",
    "preview": "vp preview",
    "test:serve": "vp dev --host 127.0.0.1 --port 4173",
    "test:smoke": "playwright test --grep @smoke --workers=3",
    "test:browser-core": "playwright test --grep \"@smoke|@byok|@dark|@a11y\" --workers=3",
    "verify:identity": "playwright test tests/identity.spec.ts --workers=1",
    "test:unit": "vp test --run",
    "test:watch": "vp test",
    "verify:architecture": "node --test scripts/verify-architecture.test.cjs && node scripts/verify-architecture.cjs",
    "verify:oxc": "node scripts/verify-oxc.mjs",
    "verify:governance": "node --test scripts/verify-governance.test.cjs && node scripts/verify-governance.cjs",
    "verify:flaky": "node --test scripts/verify-flaky-policy.test.cjs && node scripts/verify-flaky-policy.cjs",
    "verify:ui": "node scripts/verify-ui-guardrails.cjs",
    "verify:demo-copy": "node scripts/verify-demo-copy.cjs",
    "verify:tokens": "node scripts/verify-ui-tokens.cjs",
    "verify:production": "node scripts/verify-production-bundle.cjs",
    "verify:byok": "playwright test --grep @byok",
    "verify:dark": "playwright test --grep @dark",
    "verify:a11y": "playwright test --grep @a11y",
    "verify:visual": "playwright test --grep @visual --workers=1",
    "generate:sbom": "cyclonedx-npm --package-lock-only --omit dev --spec-version 1.6 --output-reproducible --output-file output/sbom.cdx.json",
    "licenses:notices": "node scripts/generate-license-notices.cjs",
    "verify:licenses": "node --test scripts/license-policy.test.cjs && node scripts/verify-license-policy.cjs ../backend/target/bom.json output/sbom.cdx.json",
    "verify:evidence": "node --test scripts/verify-evidence.test.cjs scripts/surface-manifest.test.cjs && node scripts/verify-evidence.cjs",
    "visual:diff-report": "node scripts/visual-diff-report.cjs",
    "snapshot:update": "playwright test --grep @visual --workers=1 --update-snapshots",
    "capture:surfaces": "playwright test tests/app.surfaces-capture.spec.ts --workers=1",
    "capture:demo": "playwright test --grep @demo --workers=1",
    "verify:cascade": "node scripts/verify-ui-cascade.cjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "@paper-design/shaders-react": "^0.0.82",
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-query": "^5.108.4",
    "cn": "^0.5.2",
    "echarts": "6.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "sonner": "2.0.8",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cyclonedx/cyclonedx-npm": "7.0.1",
    "@playwright/test": "^1.65.1",
    "@shadcn/lint": "^0.2.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxc-minify": "^0.160.0",
    "oxc-parser": "^0.160.0",
    "oxc-resolver": "^11.24.2",
    "oxc-transform": "^0.160.0",
    "packageurl-js": "2.0.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "playwright-core": "1.65.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest"
  },
  "engines": {
    "node": "^22.22.0 || >=24.11.0"
  },
  "packageManager": "npm@12.0.2"
}
