{
  "name": "prelude-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "npm run typecheck && npm run lint && npm run verify:architecture && npm run verify:ui && npm run verify:tokens",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test:serve": "vite build && vite preview --host 127.0.0.1",
    "test:smoke": "playwright test --grep @smoke",
    "verify:architecture": "node scripts/verify-architecture.cjs",
    "verify:ui": "node scripts/verify-ui-guardrails.cjs",
    "verify:tokens": "node scripts/verify-ui-tokens.cjs",
    "verify:production": "node scripts/verify-production-bundle.cjs",
    "verify:byok": "node scripts/verify-byok-contract.cjs && playwright test --grep @byok",
    "verify:dark": "playwright test --grep @dark",
    "verify:a11y": "playwright test --grep @a11y",
    "verify:visual": "playwright test --grep @visual --workers=1",
    "capture:visual": "playwright test --grep @visual"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@paper-design/shaders-react": "^0.0.76",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.102.8",
    "echarts": "6.1.0",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "npm@12.0.2"
}
