{
  "name": "prelude-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "check": "vp check",
    "build": "vp build",
    "preview": "vp preview",
    "test:serve": "vp dev --host 127.0.0.1 --port 4173",
    "test:smoke": "playwright test --grep @smoke --workers=1",
    "verify:architecture": "node --test scripts/verify-architecture.test.cjs && node scripts/verify-architecture.cjs",
    "verify:ui": "node scripts/verify-ui-guardrails.cjs",
    "verify:tokens": "node scripts/verify-ui-tokens.cjs",
    "verify:production": "node scripts/verify-production-bundle.cjs",
    "verify:byok": "playwright test --grep @byok",
    "verify:dark": "playwright test --grep @dark",
    "verify:a11y": "playwright test --grep @a11y",
    "verify:visual": "playwright test --grep @visual --workers=1",
    "snapshot:update": "playwright test --grep @visual --workers=1 --update-snapshots",
    "capture:surfaces": "playwright test tests/app.surfaces-capture.spec.ts --workers=1",
    "capture:demo": "playwright test --grep @demo --workers=1",
    "verify:cascade": "node scripts/verify-ui-cascade.cjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "@fontsource-variable/noto-serif-sc": "5.3.0",
    "@paper-design/shaders-react": "^0.0.76",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.102.8",
    "cn": "0.2.6",
    "echarts": "6.1.0",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@shadcn/lint": "^0.1.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.2",
    "vite-plus": "0.3.2"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.2"
  },
  "engines": {
    "node": "^22.22.0 || >=24.11.0"
  },
  "packageManager": "npm@12.0.2"
}
