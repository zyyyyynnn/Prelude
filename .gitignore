# Backend
backend/target/
backend/uploads/

# Docker Compose local env (do not commit real secrets)
.env

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env*
!frontend/.env.example
frontend/.env.local

# Playwright
.playwright-cli/

# Logs
*.log

# Generated run artifacts. The tracked interface assets live in
# docs/screenshots/surfaces/ and are regenerated by `npm run capture:surfaces`.
output/

# Office temporary lock files
~$*.docx
~$*.xlsx
~$*.pptx
*.tmp

# Local review bundles and one-off backups
thesis_literature_enhancement_package.zip
thesis-assets/*.before-literature.*

# Eclipse project metadata
backend/.classpath
backend/.factorypath
backend/.project
backend/.settings/

# Ephemeral tool caches kept inside the workspace. CI does not use this path: it sets
# `PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1` and runs the runner's own Microsoft Edge channel,
# so only local runs leave anything here.
.cache/
backend/startup*.log

target/
build/
